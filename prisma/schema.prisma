// HRMS Prisma schema (PostgreSQL)
// Module schemas (timeoff, payroll, chat, ...) will be appended here one by one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Permission a role holds on a single module.
/// NONE  -> module hidden
/// VIEW  -> read-only
/// MANAGE-> full access
enum PermissionLevel {
  NONE
  VIEW
  MANAGE
}

/// Employee type. Drives probation length and future leave/payroll policies.
enum EmployeeCategory {
  INTERN
  FRESHER
  EXPERIENCED
  CONTRACT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum SubLocationType {
  BLOCK
  FLOOR
  WING
  ZONE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/// A role bundles module permissions and is assigned to employees.
/// `key` is set only for the built-in roles (ADMIN | HR | EMPLOYEE).
model Role {
  id          String  @id @default(uuid())
  key         String? @unique
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  permissions     RolePermission[]
  users           User[]
  approvalFlows   ApprovalFlow[]
  timeOffRequests TimeOffRequest[] @relation("RequestApproverRole")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

/// One row per (role, module) grant. Only non-NONE levels are stored.
model RolePermission {
  id     String          @id @default(uuid())
  roleId String          @map("role_id")
  module String
  level  PermissionLevel @default(NONE)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([roleId, module])
  @@index([roleId])
  @@map("role_permissions")
}

/// Department master. Owned by the Organization module; employees link to it.
model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String? @unique
  description String?

  status RecordStatus @default(ACTIVE)

  // Hierarchy: sub-departments are departments with a non-null parentId.
  parentId String?     @map("parent_id")
  parent   Department? @relation("DepartmentParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentParent")

  // Department head (an employee) and the location this department sits in.
  headId     String?   @map("head_id")
  head       User?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([headId])
  @@index([locationId])
  @@map("departments")
}

/// Office location / branch. Departments and employees link to it.
model Location {
  id            String       @id @default(uuid())
  name          String       @unique
  code          String?      @unique
  addressLine1  String?      @map("address_line_1")
  addressLine2  String?      @map("address_line_2")
  city          String?
  state         String?
  country       String?
  postalCode    String?      @map("postal_code")
  timezone      String       @default("Asia/Kolkata")
  workStart     String?      @map("work_start") // HH:mm
  workEnd       String?      @map("work_end")   // HH:mm
  isDefault     Boolean      @default(false) @map("is_default")
  status        RecordStatus @default(ACTIVE)

  departments Department[]
  users       User[]
  subLocations SubLocation[]
  holidays    Holiday[]
  desks       Desk[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

/// Sub-area within a location (block, floor, wing, zone). Flat list.
model SubLocation {
  id         String          @id @default(uuid())
  locationId String          @map("location_id")
  location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  type       SubLocationType @default(OTHER)
  code       String?
  status     RecordStatus    @default(ACTIVE)

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locationId])
  @@map("sub_locations")
}

/// Previous work experience entry for an employee.
model WorkExperience {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String
  designation     String?
  fromDate        DateTime @map("from_date")
  toDate          DateTime? @map("to_date")
  currentlyWorking Boolean  @default(false) @map("currently_working")
  description     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("work_experiences")
}

/// Family member / dependent of an employee.
model FamilyMember {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  dateOfBirth  DateTime? @map("date_of_birth")
  phone        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("family_members")
}

/// Education record for an employee.
model Education {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   String
  degree        String
  fieldOfStudy  String?  @map("field_of_study")
  fromYear      Int      @map("from_year")
  toYear        Int?     @map("to_year")
  percentage    Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("educations")
}

/// Atomic sequence source for human-readable codes (EMP-0001, EMP-0002, ...).
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(ACTIVE)

  // Access is derived from the assigned role.
  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  phone        String?
  avatarUrl    String?   @map("avatar_url")
  employeeCode String?   @unique @map("employee_code")
  designation  String?
  joinedAt     DateTime? @map("joined_at")

  // Employment classification - drives probation and (later) policy defaults.
  category              EmployeeCategory @default(FRESHER)
  employmentType        EmploymentType   @default(FULL_TIME)
  priorExperienceMonths Int              @default(0) @map("prior_experience_months")
  probationEndDate      DateTime?        @map("probation_end_date")
  confirmationDate      DateTime?        @map("confirmation_date")
  contractEndDate       DateTime?        @map("contract_end_date")

  // Personal details
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                Gender?
  address               String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  emergencyContactRelationship String? @map("emergency_contact_relationship")

  // Org structure links
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  locationId    String?     @map("location_id")
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  subLocationId String?     @map("sub_location_id")
  subLocation   SubLocation? @relation(fields: [subLocationId], references: [id], onDelete: SetNull)

  // Onboarding gate: employees cannot self-edit until this is true.
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  // Bank / statutory details (plain text for v1)
  bankName    String? @map("bank_name")
  bankAccount String? @map("bank_account")
  ifsc        String?
  pan         String?
  aadhaar     String?
  uan         String?

  bloodGroup    String?        @map("blood_group")
  maritalStatus MaritalStatus? @map("marital_status")

  // Self relation: reporting manager (used by team / manager views and chat)
  managerId String? @map("manager_id")
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  // Back-relation: departments where this user is the head.
  headOf Department[] @relation("DepartmentHead")

  refreshTokenHash String?   @map("refresh_token_hash")
  lastLoginAt      DateTime? @map("last_login_at")

  timeOffRequests  TimeOffRequest[] @relation("RequestEmployee")
  approvedRequests TimeOffRequest[] @relation("RequestApprover")
  leaveBalances    LeaveBalance[]
  payslips         Payslip[]        @relation("PayslipEmployee")
  uploadedPayslips Payslip[]        @relation("PayslipUploader")
  notifications    Notification[]

  // My Info child collections
  workExperiences WorkExperience[]
  familyMembers   FamilyMember[]
  educations      Education[]

  holidayAvails HolidayAvail[]

  // Policy module
  createdPolicies      Policy[]               @relation("PolicyCreator")
  policyAcknowledgments PolicyAcknowledgment[]

  // Events module
  createdEvents Event[]    @relation("EventCreator")
  eventRsvps   EventRSVP[]

  // Desk Management module
  deskBookings DeskBooking[]

  // IT Support & HR Help Desk modules
  createdTickets  Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  ticketComments TicketComment[]

  // Expenses module
  expenseClaims         ExpenseClaim[] @relation("ExpenseClaimEmployee")
  expenseDecisions      ExpenseClaim[] @relation("ExpenseClaimDecider")
  expenseReimbursements ExpenseClaim[] @relation("ExpenseClaimReimburser")

  // Chat module - an employee's messaging footprint (see chat models below).
  chatMemberships ConversationMember[]
  chatMessages    Message[]
  chatAttachments MessageAttachment[]
  chatReceipts    MessageReceipt[]
  chatReactions   MessageReaction[]
  chatPins        PinnedMessage[]
  chatPresence    UserPresence?
  chatSettings    UserSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([managerId])
  @@index([departmentId])
  @@index([employeeCode])
  @@map("users")
}

/**
 * =========================================================
 * Time Off module
 * ---------------------------------------------------------
 * A single TimeOffRequest row covers all four request types
 * (LEAVE, PERMISSION, REGULARIZATION, EXTRA_HOURS). The
 * type-specific fields are nullable; only those relevant to
 * the request type are populated.
 * =========================================================
 */

enum TimeOffRequestType {
  LEAVE
  PERMISSION
  REGULARIZATION
  EXTRA_HOURS
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  COMP_OFF
  PERSONAL
  UNPAID
}

model TimeOffRequest {
  id     String               @id @default(uuid())
  type   TimeOffRequestType
  status TimeOffRequestStatus @default(PENDING)

  employeeId String @map("employee_id")
  employee   User   @relation("RequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  // ---- LEAVE fields ----
  leaveType LeaveType? @map("leave_type")
  fromDate  DateTime?  @map("from_date")
  toDate    DateTime?  @map("to_date")
  days      Decimal?   @db.Decimal(5, 2)

  // ---- PERMISSION fields (short duration, same day) ----
  permissionDate DateTime? @map("permission_date")
  fromTime       String?   @map("from_time") // HH:mm
  toTime         String?   @map("to_time")

  // ---- REGULARIZATION fields (fix missing punches) ----
  regularizationDate DateTime? @map("regularization_date")
  actualInTime       String?   @map("actual_in_time")
  actualOutTime      String?   @map("actual_out_time")

  // ---- EXTRA_HOURS fields (overtime) ----
  extraHoursDate DateTime? @map("extra_hours_date")
  extraHoursFrom String?   @map("extra_hours_from")
  extraHoursTo   String?   @map("extra_hours_to")
  extraHours     Decimal?  @map("extra_hours") @db.Decimal(5, 2)

  reason          String
  // Approval audit trail
  approverId      String?   @map("approver_id")
  approver        User?     @relation("RequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approverRoleId  String?   @map("approver_role_id")
  approverRole    Role?     @relation("RequestApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  approvedAt      DateTime? @map("approved_at")
  approvalComment String?   @map("approval_comment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@map("time_off_requests")
}

/**
 * Per-employee leave allowance for a given leave type and year.
 */
model LeaveBalance {
  id         String    @id @default(uuid())
  employeeId String    @map("employee_id")
  employee   User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @map("leave_type")
  year       Int
  total      Decimal   @db.Decimal(6, 2)
  used       Decimal   @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@map("leave_balances")
}

/**
 * Which role approves each time-off request type. Default: HR.
 */
model ApprovalFlow {
  id             String             @id @default(uuid())
  requestType    TimeOffRequestType @unique @map("request_type")
  approverRoleId String             @map("approver_role_id")
  approverRole   Role               @relation(fields: [approverRoleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([approverRoleId])
  @@map("approval_flows")
}

/**
 * =========================================================
 * Chat module
 * ---------------------------------------------------------
 * Internal employee messaging. Chat identities are the
 * existing `users` rows - there is no separate identity table.
 * Tables use a `chat_` prefix so chat data stays logically
 * separate from HRMS tables while remaining in the existing
 * `public` schema (keeps every existing model untouched).
 * =========================================================
 */

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  SYSTEM
}

enum PresenceStatus {
  ONLINE
  OFFLINE
}

/// A 1:1 (DIRECT) or multi-member (GROUP) conversation.
model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  name          String?
  description   String?
  avatarPath    String?          @map("avatar_path")
  createdById   String?          @map("created_by")
  lastMessageId String?          @map("last_message_id")
  isActive      Boolean          @default(true) @map("is_active")

  /// DIRECT only: deterministic key for the unordered employee pair
  /// ("<minId>:<maxId>") so a pair can never end up with two conversations.
  directKey String? @unique @map("direct_key")

  members  ConversationMember[]
  messages Message[]
  pins     PinnedMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([lastMessageId])
  @@map("chat_conversations")
}

/// Membership of an employee in a conversation (with per-member state).
model ConversationMember {
  id                String                 @id @default(uuid())
  conversationId    String                 @map("conversation_id")
  employeeId        String                 @map("employee_id")
  role              ConversationMemberRole @default(MEMBER)
  isMuted           Boolean                @default(false) @map("is_muted")
  isArchived        Boolean                @default(false) @map("is_archived")
  lastReadMessageId String?                @map("last_read_message_id")
  lastReadAt        DateTime?              @map("last_read_at")
  joinedAt          DateTime               @default(now()) @map("joined_at")
  leftAt            DateTime?              @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([conversationId, employeeId])
  @@index([employeeId])
  @@index([conversationId])
  @@map("chat_conversation_members")
}

/// A single chat message. Soft-deleted, never hard-removed by default.
model Message {
  id                     String          @id @default(uuid())
  conversationId         String          @map("conversation_id")
  senderId               String?         @map("sender_employee_id")
  messageType            ChatMessageType @default(TEXT) @map("message_type")
  content                String?
  replyToMessageId       String?         @map("reply_to_message_id")
  forwardedFromMessageId String?         @map("forwarded_from_message_id")
  /// Client-generated idempotency key - makes retries safe.
  clientMessageId        String?         @map("client_message_id")
  isDeleted              Boolean         @default(false) @map("is_deleted")
  editedAt               DateTime?       @map("edited_at")
  deletedAt              DateTime?       @map("deleted_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  receipts     MessageReceipt[]
  reactions    MessageReaction[]
  pins         PinnedMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isDeleted])
  @@map("chat_messages")
}

/// Metadata for a file stored on the Linux filesystem (never in Postgres).
model MessageAttachment {
  id               String  @id @default(uuid())
  messageId        String  @map("message_id")
  uploadedById     String? @map("uploaded_by_employee_id")
  originalFilename String  @map("original_filename")
  storedFilename   String  @map("stored_filename")
  storagePath      String  @map("storage_path")
  thumbnailPath    String? @map("thumbnail_path")
  mimeType         String  @map("mime_type")
  fileExtension    String? @map("file_extension")
  fileSize         Int     @map("file_size")
  category         String?
  checksum         String?
  width            Int?
  height           Int?

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("chat_message_attachments")
}

/// Per-recipient delivery + read state for a message.
model MessageReceipt {
  id          String    @id @default(uuid())
  messageId   String    @map("message_id")
  employeeId  String    @map("employee_id")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([messageId, employeeId])
  @@index([employeeId])
  @@map("chat_message_receipts")
}

/// An emoji reaction; one row per (message, employee, emoji).
model MessageReaction {
  id         String @id @default(uuid())
  messageId  String @map("message_id")
  employeeId String @map("employee_id")
  reaction   String

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([messageId, employeeId, reaction])
  @@index([messageId])
  @@map("chat_message_reactions")
}

/// A message pinned within a conversation.
model PinnedMessage {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  messageId      String  @map("message_id")
  pinnedById     String? @map("pinned_by_employee_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User?        @relation(fields: [pinnedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("chat_pinned_messages")
}

/// Presence is derived from live sockets and mirrored here for last-seen.
model UserPresence {
  employeeId String         @id @map("employee_id")
  status     PresenceStatus @default(OFFLINE)
  lastSeenAt DateTime?      @map("last_seen_at")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_user_presence")
}

/// Per-employee chat preferences.
model UserSettings {
  employeeId          String  @id @map("employee_id")
  notificationEnabled Boolean @default(true) @map("notification_enabled")
  soundEnabled        Boolean @default(true) @map("sound_enabled")

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_user_settings")
}

/// One private PDF payslip per employee and payroll month.
model Payslip {
  id               String   @id @default(uuid())
  employeeId       String   @map("employee_id")
  uploadedById     String   @map("uploaded_by_id")
  payrollPeriod    DateTime @db.Date @map("payroll_period")
  originalFilename String   @map("original_filename")
  storagePath      String   @map("storage_path")
  fileSize         Int      @map("file_size")
  checksum         String

  employee   User @relation("PayslipEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("PayslipUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([employeeId, payrollPeriod])
  @@index([payrollPeriod])
  @@map("payslips")
}

/// Organization-wide profile used by the Settings module.
model OrganizationProfile {
  id           String   @id @default("primary")
  name         String   @default("HRMS Workspace")
  supportEmail String?  @map("support_email")
  timezone     String   @default("Asia/Kolkata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organization_profiles")
}

/// User-scoped in-app notifications generated by HR workflows.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  title     String
  body      String
  href      String
  readAt    DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/**
 * =========================================================
 * Holidays module
 * ---------------------------------------------------------
 * Public holidays apply to everyone; optional holidays are
 * a configurable pool employees can "avail" up to an annual
 * allowance. A manager can see their direct reports' avails.
 * =========================================================
 */

enum HolidayType {
  PUBLIC
  OPTIONAL
}

model Holiday {
  id          String      @id @default(uuid())
  name        String
  date        DateTime    @db.Date
  type        HolidayType @default(PUBLIC)
  description String?
  year        Int
  status      RecordStatus @default(ACTIVE)

  // Optional location scope; null applies to all locations.
  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  avails HolidayAvail[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([year])
  @@index([date])
  @@index([locationId])
  @@map("holidays")
}

/// Single-row holiday configuration (e.g. optional holiday allowance).
model HolidaySettings {
  id                      String @id @default("primary")
  optionalHolidayAllowance Int    @default(2) @map("optional_holiday_allowance")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("holiday_settings")
}

/// An employee availing an optional holiday (one per holiday+employee).
model HolidayAvail {
  id        String   @id @default(uuid())
  holidayId String   @map("holiday_id")
  userId    String   @map("user_id")
  year      Int

  holiday Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([holidayId, userId])
  @@index([userId, year])
  @@map("holiday_avails")
}

/**
 * =========================================================
 * Policy Management module
 * ---------------------------------------------------------
 * A Policy is a published company policy document that
 * employees must review and acknowledge. Draft policies are
 * only visible to HR/Admin; published policies are visible
 * to all employees with their per-user acknowledgment status.
 * =========================================================
 */

enum PolicyStatus {
  DRAFT
  PUBLISHED
}

model Policy {
  id               String       @id @default(uuid())
  title            String
  description      String?
  category         String?
  documentPath     String       @map("document_path")
  originalFilename String       @map("original_filename")
  mimeType         String       @map("mime_type")
  fileSize         Int          @map("file_size")
  status           PolicyStatus @default(DRAFT)
  effectiveDate    DateTime?    @db.Date @map("effective_date")
  version          Int          @default(1)

  createdById String @map("created_by_id")
  createdBy   User   @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  acknowledgments PolicyAcknowledgment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@map("policies")
}

/// A formal acknowledgment that an employee has reviewed a published policy.
model PolicyAcknowledgment {
  id        String   @id @default(uuid())
  policyId  String   @map("policy_id")
  userId    String   @map("user_id")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([policyId, userId])
  @@index([userId])
  @@map("policy_acknowledgments")
}

/**
 * =========================================================
 * Desk Management module
 * ---------------------------------------------------------
 * Minimal desk booking: desks belong to an optional location
 * and can be booked by employees for a single day. One desk
 * may only have one active booking per day.
 * =========================================================
 */

enum DeskBookingStatus {
  BOOKED
  CANCELLED
}

model Desk {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  locationId  String?       @map("location_id")
  location    Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status      RecordStatus  @default(ACTIVE)

  bookings DeskBooking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locationId])
  @@map("desks")
}

model DeskBooking {
  id        String            @id @default(uuid())
  deskId    String            @map("desk_id")
  userId    String            @map("user_id")
  date      DateTime          @db.Date
  status    DeskBookingStatus @default(BOOKED)
  notes     String?

  desk Desk @relation(fields: [deskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([deskId, date])
  @@index([userId, date])
  @@map("desk_bookings")
}

/**
 * =========================================================
 * Events module
 * ---------------------------------------------------------
 * Company-wide events that employees can RSVP to.
 * =========================================================
 */

enum EventRSVPResponse {
  GOING
  INTERESTED
  NOT_GOING
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?     @map("end_date")
  location    String?
  category    String?
  createdById String        @map("created_by_id")
  createdBy   User          @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status      RecordStatus  @default(ACTIVE)

  rsvps EventRSVP[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("events")
}

model EventRSVP {
  id        String             @id @default(uuid())
  eventId   String             @map("event_id")
  userId    String             @map("user_id")
  response  EventRSVPResponse  @default(GOING)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

/**
 * =========================================================
 * IT Support & HR Help Desk modules
 * ---------------------------------------------------------
 * Shared ticket infrastructure for both modules.
 * `module` distinguishes IT Support tickets from HR Help
 * Desk tickets. Categories are scoped per module.
 * =========================================================
 */

enum TicketModule {
  IT_SUPPORT
  HR_HELPDESK
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model TicketCategory {
  id      String        @id @default(uuid())
  name    String
  module  TicketModule
  icon    String?
  active  Boolean       @default(true)

  tickets Ticket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, module])
  @@index([module])
  @@map("ticket_categories")
}

model Ticket {
  id          String        @id @default(uuid())
  module      TicketModule
  title       String
  description String
  categoryId  String        @map("category_id")
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  createdById String   @map("created_by_id")
  createdBy   User     @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?  @map("assigned_to_id")
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")

  comments TicketComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([module, status])
  @@index([module, priority])
  @@index([createdById])
  @@index([assignedToId])
  @@map("tickets")
}

model TicketComment {
  id       String  @id @default(uuid())
  ticketId String  @map("ticket_id")
  userId   String  @map("user_id")
  message  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ticketId])
  @@map("ticket_comments")
}

/**
 * =========================================================
 * Expenses module
 * ---------------------------------------------------------
 * An ExpenseClaim is the header an employee submits; it
 * carries one or more ExpenseItem line items. Each item
 * belongs to an ExpenseCategory, which can declare a
 * per-line cap and a receipt-required threshold.
 *
 * Status flow (simplified, single decision per claim):
 *   DRAFT → SUBMITTED → APPROVED → REIMBURSED
 *                     ↘ REJECTED
 *                     ↘ CLARIFICATION → SUBMITTED
 * =========================================================
 */

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CLARIFICATION
  REIMBURSED
}

enum ExpensePaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

model ExpenseCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?
  /** Optional cap per line item in this category (null = uncapped). */
  maxAmount            Decimal? @map("max_amount") @db.Decimal(12, 2)
  /** A receipt becomes mandatory once a line exceeds this amount (null = never). */
  receiptRequiredAbove Decimal? @map("receipt_required_above") @db.Decimal(12, 2)
  active      Boolean @default(true)

  items ExpenseItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("expense_categories")
}

model ExpenseClaim {
  id          String  @id @default(uuid())
  /** Human-readable claim number, e.g. EXP-0001. */
  code        String  @unique
  title       String
  description String?
  currency    String  @default("INR")

  employeeId String @map("employee_id")
  employee   User   @relation("ExpenseClaimEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  status      ExpenseStatus @default(DRAFT)
  totalAmount Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)

  submittedAt DateTime? @map("submitted_at")

  // Manager decision (approve / reject / request clarification).
  decidedById  String?   @map("decided_by_id")
  decidedBy    User?     @relation("ExpenseClaimDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")

  // HR / Finance reimbursement.
  reimbursedById   String?             @map("reimbursed_by_id")
  reimbursedBy     User?               @relation("ExpenseClaimReimburser", fields: [reimbursedById], references: [id], onDelete: SetNull)
  reimbursedAt     DateTime?           @map("reimbursed_at")
  reimbursementRef String?             @map("reimbursement_ref")
  paymentMode      ExpensePaymentMode? @map("payment_mode")

  items ExpenseItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([status])
  @@map("expense_claims")
}

model ExpenseItem {
  id         String @id @default(uuid())
  claimId    String @map("claim_id")
  claim      ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  categoryId String @map("category_id")
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  expenseDate DateTime           @map("expense_date")
  amount      Decimal            @db.Decimal(12, 2)
  description String?
  paymentMode ExpensePaymentMode @default(OTHER) @map("payment_mode")

  // Receipt attachment (optional until a category asks for one).
  receiptPath     String? @map("receipt_path")
  receiptFilename String? @map("receipt_filename")
  receiptMimeType String? @map("receipt_mime_type")
  receiptSize     Int?    @map("receipt_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([claimId])
  @@index([categoryId])
  @@map("expense_items")
}

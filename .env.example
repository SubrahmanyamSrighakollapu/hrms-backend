# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS - comma separated origins allowed to call the API (frontend)
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Seed defaults
SEED_ADMIN_EMAIL=admin@hrms.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_HR_EMAIL=hr@hrms.local
SEED_HR_PASSWORD=Hr@12345
